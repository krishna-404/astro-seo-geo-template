---
/**
 * FAQ accordion with zero JavaScript.
 *
 * Exclusive open comes free from the platform: <details name="..."> elements
 * sharing a name form a group where opening one closes the others — no
 * aria-expanded bookkeeping, keyboard and screen-reader support native.
 * The open/close animation is pure CSS on ::details-content and lives inside
 * `prefers-reduced-motion: no-preference` (AGENTS rule 14): reduced-motion
 * users and older browsers get an instant toggle, which is the correct
 * degraded state, not a missing feature.
 *
 * Single-source with the schema: the same `faq` array feeds this component
 * and faqPageNode() (src/lib/faqSchema.ts), so the on-page questions and the
 * FAQPage JSON-LD cannot drift apart.
 *
 * Every toggle is measured (AGENTS rule 3): a collapsed answer costs the
 * reader a click and pays for it with the only first-party signal the site
 * gets about which questions visitors actually relate to. The `faq` event
 * carries the question text and a `place`, via the same declarative
 * data attributes every CTA uses — no custom JavaScript, native <details>
 * does the collapsing and the analytics tracker binds the attribute. The
 * binding fires on every <summary> click, so counts include closes as well
 * as opens; the first click on a question is always an open, so treat the
 * number as engagement, not a precise open-count.
 */
interface Props {
  faq: { q: string; a: string }[];
  /** Groups the <details> for exclusive-open; use the entry slug. */
  groupName: string;
  heading?: string;
  /** Where this FAQ lives, for the event's place property — e.g. "home",
   *  "glossary:demurrage". Keep it stable; it is an analytics dimension.
   *  Defaults to groupName. */
  place?: string;
}

const { faq, groupName, heading = 'Questions this raises', place = groupName } = Astro.props;
---

<section class="faq">
  <h2>{heading}</h2>
  {
    faq.map((f) => (
      <details name={`faq-${groupName}`}>
        <summary data-umami-event="faq" data-umami-event-question={f.q} data-umami-event-place={place}>
          {f.q}
        </summary>
        <p>{f.a}</p>
      </details>
    ))
  }
</section>

<style>
  .faq {
    margin-top: 2.5rem;
  }
  .faq summary {
    font-weight: 700;
    cursor: pointer;
    line-height: 1.5;
    padding: 0.625rem 0;
  }
  .faq details {
    border-top: 1px solid var(--line-2);
  }
  .faq details p {
    margin: 0.25rem 0 0.875rem;
    line-height: 1.7;
  }

  /* Animated disclosure, motion-safe only — outside this block the toggle is
     instant, which is the intended reduced-motion behaviour. Browsers without
     ::details-content / interpolate-size ignore these rules entirely. */
  @media (prefers-reduced-motion: no-preference) {
    .faq details {
      interpolate-size: allow-keywords;
    }
    .faq details::details-content {
      block-size: 0;
      overflow-y: clip;
      transition:
        content-visibility 0.25s allow-discrete,
        block-size 0.25s;
    }
    .faq details[open]::details-content {
      block-size: auto;
    }
  }
</style>
