---
/**
 * The enquiry form. Posts to /api/contact, which the edge worker (or your
 * reverse proxy) forwards to the configured backend — a Google Apps Script Web
 * App writing to a sheet, in the default setup.
 *
 * IT WORKS WITH JAVASCRIPT OFF, and that is the whole design.
 *
 * A plain `method="post"` and a redirect to a real /contact/thanks page means a
 * submission cannot vanish into a failed fetch, there is no spinner state to
 * get wrong, and the thank-you URL is a free analytics conversion with no extra
 * script. The form does not need to compute anything, so it ships no JS at all
 * beyond the additive attribution snippet below.
 *
 * WHY IT POSTS SAME-ORIGIN. Pointing the form straight at the Apps Script URL
 * would navigate the visitor to script.googleusercontent.com and show them a
 * Google-hosted page — which is how most Apps Script forms end up feeling
 * broken. The same-origin proxy keeps the browser on your domain and keeps the
 * script URL, which is write-capable, out of the page source.
 *
 * SPAM: a honeypot here plus rate limiting at the edge. There is deliberately
 * no "submitted too fast" timestamp check — this is a static build, so any
 * timestamp rendered into the page is the BUILD time, not the visitor's page
 * load, and would reject everyone or nobody depending on how old the deploy is.
 */

interface Props {
  /** Recorded with the submission, so leads can be traced to the page they came from. */
  source: string;
  heading?: string;
}

const { source, heading = 'Send us a message' } = Astro.props;
---

<form class="cf card" method="post" action="/api/contact">
  <h2 class="cf__h">{heading}</h2>
  <p class="cf__sub">We usually reply within one working day.</p>

  <input type="hidden" name="source" value={source} />

  {/*
    Attribution. Empty in the markup and filled by the script below, which is
    the only JavaScript this component has — and it is strictly additive: with
    it blocked these stay empty and the form submits exactly as before.

    WHAT THESE CAN AND CANNOT TELL YOU. document.referrer is the page
    immediately before this one, and it is overwritten on every navigation. A
    visitor who arrives from Google on a blog post and then clicks through to
    /contact carries "yourdomain.com/blog/…" here, not Google — the original
    source is already gone by the time the form renders. So this is LAST TOUCH,
    which is why the column is called "Came from" and not "Source".

    Persisting the first referrer is what analytics suites do, and it needs
    somewhere to keep it. Not available here: localStorage and sessionStorage
    are banned repo-wide, and a cookie for attribution is not strictly
    necessary, so it would need consent — a second optional cookie, which breaks
    the consent banner's two-button design and would bias the data to people who
    accepted. Aggregate analytics already answers the aggregate question; it
    simply cannot tie a session to one row in a sheet.
  */}
  <input type="hidden" name="ref" value="" />
  <input type="hidden" name="campaign" value="" />

  {/*
    Honeypot. Off-screen rather than display:none — some bots skip hidden
    fields but fill positioned ones. aria-hidden and tabindex=-1 keep it away
    from screen readers and the tab order, so it costs nothing in a11y terms.

    NAMED `hp`, AND THAT MATTERS. It was `website` first, which is one of the
    names Chrome and every password manager will happily autofill when it sits
    beside name, email and company. An autofilled honeypot rejects a real
    person, and it does it silently and indistinguishably from spam. Do not
    rename this to anything a browser might recognise.
  */}
  <div class="cf__hp" aria-hidden="true">
    <label for={`hp-${source}`}>Leave this field empty</label>
    <input id={`hp-${source}`} type="text" name="hp" tabindex="-1" autocomplete="off" />
  </div>

  <div class="cf__grid">
    <label class="cf__f">
      <span>Your name</span>
      <input type="text" name="name" autocomplete="name" required maxlength="120" />
    </label>

    <label class="cf__f">
      <span>Work email</span>
      <input type="email" name="email" autocomplete="email" required maxlength="180" />
    </label>

    <label class="cf__f cf__f--wide">
      <span>Company <span class="cf__optional">(optional)</span></span>
      <input type="text" name="company" autocomplete="organization" maxlength="160" />
    </label>
  </div>

  <label class="cf__f cf__f--wide">
    <span>How can we help?</span>
    <textarea name="message" rows="4" required maxlength="4000"></textarea>
  </label>

  {/*
    Unticked, and separate from the enquiry itself. Replying to a business
    enquiry is a pre-contractual step and needs no consent; sending anything
    else later does. A pre-ticked box is not consent under any of PDPA, PDPL,
    DPDP or the GDPR — see /privacy-policy.
  */}
  <label class="cf__opt">
    <input type="checkbox" name="optin" value="yes" />
    <span>Email me the occasional update. No more than monthly.</span>
  </label>

  <div class="cf__foot">
    <button
      class="btn btn--primary"
      type="submit"
      data-umami-event="form-submit"
      data-umami-event-place={source}>Send message</button
    >
    <p class="fine cf__legal">
      We use this to reply to you and nothing else. <a href="/privacy-policy">How we handle it</a>.
    </p>
  </div>

  {/*
    `is:inline` matters: without it Astro bundles this into a module and emits a
    <script src>, which would put a network request on the critical path of a
    page that currently ships none of our JavaScript. Inline, it costs a few
    hundred bytes inside HTML that is already being downloaded.

    Everything here is optional by construction — no submit handler, no
    preventDefault, no fetch. If it throws, or never runs, the two hidden fields
    stay empty and the form posts exactly as it would have.
  */}
  <script is:inline>
    (function () {
      try {
        var form = document.currentScript.closest('form');
        if (!form) return;

        var put = function (name, value) {
          var el = form.querySelector('input[name="' + name + '"]');
          // Capped: these end up in a spreadsheet cell, and a referrer can
          // carry a very long query string.
          if (el && value) el.value = String(value).slice(0, 300);
        };

        put('ref', document.referrer);

        // Read from THIS page's URL, not the referrer's — the one case where
        // the original source survives all the way to the form.
        //
        // The path form is what we send: yourdomain.com/hi/<code>, served by an
        // internal rewrite so it stays in the address bar. Query parameters are
        // still honoured because other platforms append their own, but we do
        // not put ?utm_source= on our own links — the /hi rewrite exists so the
        // shared URL stays short and human.
        var q = new URLSearchParams(location.search);
        var path = /^\/hi\/([A-Za-z0-9][A-Za-z0-9-]{0,39})\/?$/.exec(location.pathname);
        put(
          'campaign',
          q.get('utm_source') || q.get('utm_campaign') || q.get('ref') || (path && path[1]) || ''
        );
      } catch (e) {
        /* Attribution is never worth breaking a form for. */
      }
    })();
  </script>
</form>

<style>
  .cf {
    display: grid;
    gap: 0.875rem;
    padding: 1.5rem 1.25rem;
  }

  .cf__h {
    font-size: 1.125rem;
    margin: 0;
  }

  .cf__sub {
    font-size: 0.9375rem;
    color: var(--ink-3);
    margin: -0.5rem 0 0.25rem;
  }

  /* Off-screen, not hidden — see the note in the component head. */
  .cf__hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .cf__grid {
    display: grid;
    gap: 0.875rem;
    grid-template-columns: 1fr;
  }

  .cf__f {
    display: grid;
    gap: 0.3rem;
  }

  .cf__f > span {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink-2);
  }

  .cf__optional {
    font-weight: 400;
    color: var(--ink-3);
  }

  .cf :is(input[type='text'], input[type='email'], textarea) {
    width: 100%;
    min-height: 44px; /* touch target */
    padding: 0.55rem 0.7rem;
    font: inherit;
    font-size: 1rem; /* 16px — anything smaller makes iOS zoom on focus */
    color: var(--ink);
    background: var(--white);
    border: 1px solid var(--line-2);
    border-radius: 8px;
  }

  .cf textarea {
    min-height: 6rem;
    resize: vertical;
  }

  .cf :is(input, textarea):focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 1px;
    border-color: var(--brand);
  }

  .cf__opt {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.6rem;
    align-items: start;
    font-size: 0.8125rem;
    color: var(--ink-3);
  }

  .cf__opt input {
    width: 1.05rem;
    height: 1.05rem;
    margin-top: 0.15rem;
  }

  .cf__foot {
    display: grid;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }

  .cf__legal {
    margin: 0;
  }

  .cf__foot .btn {
    justify-self: start;
  }

  @media (min-width: 34rem) {
    .cf__grid {
      grid-template-columns: 1fr 1fr;
    }
    .cf__f--wide {
      grid-column: 1 / -1;
    }
  }
</style>
