---
/**
 * The related-content block — rendered from build-time scoring
 * (src/lib/related.ts), so every entry links its topical neighbours with zero
 * client JS. `data-pagefind-ignore` keeps neighbours' titles out of this
 * page's search index entry (otherwise every result surfaces its neighbours
 * too and results muddy). Not part of the markdown twins: this is site
 * chrome, not article content — agents get the full index from llms.txt.
 */
import type { RelatedCandidate } from '../lib/related';
import collectionsConfig from '../data/collections.json';

/**
 * Collection → route directory, from src/data/collections.json. A collection's
 * folder name and its route can differ (`comparison` renders under /vs), and
 * this component used to build `/{collection}/{id}` directly — which was true
 * for the two collections that existed and a dead link for the third.
 */
const ROUTE: Record<string, string> = Object.fromEntries(
  Object.entries(collectionsConfig.collections).map(([name, cfg]) => [name, cfg.route])
);

interface Props {
  items: RelatedCandidate[];
  heading?: string;
}

const { items, heading = 'Related reading' } = Astro.props;
---

{
  items.length > 0 && (
    <section class="related" aria-labelledby="related-heading" data-pagefind-ignore>
      <h2 id="related-heading">{heading}</h2>
      <ul>
        {items.map((item) => (
          <li>
            <a href={`${ROUTE[item.collection] ?? `/${item.collection}`}/${item.id}`}>{item.title}</a> —{' '}
            {item.summary}
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .related {
    margin-top: 2.5rem;
  }
  .related ul {
    padding-left: 1.1rem;
    margin: 0;
  }
  .related li {
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }
  .related a {
    font-weight: 700;
  }
</style>
