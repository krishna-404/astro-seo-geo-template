---
import { ANALYTICS, CONSENT } from '../data/site';

/**
 * Cookie consent gate.
 *
 * The site's only non-essential cookies come from GA4, so this is a two-button
 * banner, not a preference centre with toggles nobody reads. Building a
 * category matrix for a single vendor would be theatre.
 *
 * WHAT IS GATED AND WHAT IS NOT:
 *   - GA4             gated. The gtag snippet does not load at all until
 *                     "Accept" is clicked.
 *   - Umami           NOT gated. Self-hosted, sets no cookie, stores nothing on
 *                     the device. ePrivacy consent attaches to storage access on
 *                     the visitor's device, and there is none to consent to.
 *   - Consent cookie  NOT gated. Recording a refusal is what makes the refusal
 *                     stick; a banner that needs consent to remember "no" is
 *                     broken by construction.
 *
 * CONSENT IS PRIOR, NOT RETROACTIVE. The tracker is injected by this script on
 * click, never rendered into the page and disabled afterwards. If you ever move
 * the gtag snippet back into BaseLayout's head, this banner becomes decoration
 * and the compliance story is gone.
 *
 * CTA MEASUREMENT SURVIVES THE VENDOR SWAP. Every CTA in the markup carries
 * `data-umami-event` / `data-umami-event-place` — Umami binds those natively.
 * On Accept this script also installs a small click forwarder that relays the
 * same attributes to gtag, so one set of vendor-neutral attributes reports to
 * whichever provider is live.
 *
 * STORED IN A COOKIE, NOT localStorage — web storage is banned repo-wide, and a
 * consent record is the textbook "strictly necessary" cookie anyway.
 */

const script = `
(function () {
  var NAME = ${JSON.stringify(CONSENT.cookieName)};
  var DAYS = ${CONSENT.maxAgeDays};
  var MID = ${JSON.stringify(ANALYTICS.ga4.measurementId)};

  function read(name) {
    var hit = document.cookie.split('; ').find(function (row) {
      return row.indexOf(name + '=') === 0;
    });
    return hit ? hit.split('=')[1] : null;
  }

  function write(name, value, days) {
    document.cookie =
      name + '=' + value + ';path=/;max-age=' + 60 * 60 * 24 * days +
      ';SameSite=Lax' + (location.protocol === 'https:' ? ';Secure' : '');
  }

  /**
   * Relays CTA clicks to GA4. The markup's data-umami-event attributes are the
   * single source of truth for event names; this listener just forwards them,
   * so enabling GA4 needs no markup changes. Additive and fail-safe: if it
   * throws, the click still navigates.
   */
  function installCtaForwarder() {
    document.addEventListener('click', function (e) {
      try {
        var el = e.target && e.target.closest && e.target.closest('[data-umami-event]');
        if (!el || typeof window.gtag !== 'function') return;
        // Forward every data-umami-event-* attribute as an event property, so
        // markup that adds a dimension (like the FAQ accordion's question)
        // needs no change here. NB: this whole script is a template literal —
        // no backticks or dollar-brace interpolation, even in comments.
        var props = {};
        for (var i = 0; i < el.attributes.length; i += 1) {
          var a = el.attributes[i];
          if (a.name.indexOf('data-umami-event-') === 0) {
            props[a.name.slice('data-umami-event-'.length)] = a.value;
          }
        }
        window.gtag('event', el.getAttribute('data-umami-event'), props);
      } catch (err) { /* Analytics is never worth breaking a click for. */ }
    });
  }

  /**
   * The GA4 snippet, injected on consent rather than rendered on load.
   * Guarded because "Accept" can be clicked again from the footer re-open.
   */
  var loaded = false;
  function loadTracker() {
    if (loaded || !MID) return;
    loaded = true;
    var s = document.createElement('script');
    s.async = true;
    s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(MID);
    document.head.appendChild(s);
    window.dataLayer = window.dataLayer || [];
    window.gtag = function () { window.dataLayer.push(arguments); };
    window.gtag('js', new Date());
    window.gtag('config', MID);
    installCtaForwarder();
  }

  /**
   * Withdrawing consent has to actually remove what was set, or "Reject" is a
   * lie the second time someone clicks it. The page cannot see HttpOnly cookies
   * and cannot touch the vendor's own domain, so this clears what is reachable:
   * the first-party GA cookies, on this host and on the dot-domain variant.
   *
   * A trailing * in a configured name is prefix-matched against the cookies
   * actually present — needed because GA4's session cookie embeds the
   * measurement id in its NAME (_ga_XXXXXXXXXX), so it cannot be listed
   * literally in site.ts.
   */
  function clearTrackerCookies() {
    var host = location.hostname;
    var domains = ['', ';domain=' + host, ';domain=.' + host.replace(/^www\\./, '')];
    var present = document.cookie.split('; ').map(function (row) {
      return row.split('=')[0];
    });
    ${JSON.stringify(CONSENT.trackerCookies)}.forEach(function (pattern) {
      var names =
        pattern.slice(-1) === '*'
          ? present.filter(function (n) {
              return n.indexOf(pattern.slice(0, -1)) === 0;
            })
          : [pattern];
      names.forEach(function (name) {
        domains.forEach(function (d) {
          document.cookie = name + '=;path=/;max-age=0' + d;
        });
      });
    });
  }

  var banner = document.getElementById('consent');
  function show() { if (banner) banner.hidden = false; }
  function hide() { if (banner) banner.hidden = true; }

  function decide(value) {
    write(NAME, value, DAYS);
    if (value === 'granted') loadTracker();
    else clearTrackerCookies();
    hide();
  }

  var current = read(NAME);
  if (current === 'granted') loadTracker();
  else if (current !== 'denied') show();

  if (banner) {
    banner.querySelector('[data-consent="accept"]').addEventListener('click', function () {
      decide('granted');
    });
    banner.querySelector('[data-consent="reject"]').addEventListener('click', function () {
      decide('denied');
    });
  }

  // Footer entry point, so a decision can be changed without clearing cookies
  // by hand. Withdrawal has to be as easy as giving it.
  document.querySelectorAll('[data-consent-reopen]').forEach(function (el) {
    el.addEventListener('click', function (e) {
      e.preventDefault();
      show();
      var accept = banner && banner.querySelector('[data-consent="accept"]');
      if (accept) accept.focus();
    });
  });
})();
`;
---

{/* Rendered for every visitor and revealed by script, so the markup is in the
    HTML for assistive tech before any decision is made. `hidden` keeps it out
    of the layout until it is needed. */}
<div
  id="consent"
  class="consent"
  role="dialog"
  aria-labelledby="consent-title"
  aria-describedby="consent-body"
  hidden
>
  <div class="consent__card">
    <p id="consent-title" class="consent__title">Cookies</p>
    {/* Kept to two lines at 375px on purpose. Every extra line makes the banner
        taller, and a tall fixed banner covers the hero CTA — measured at 667px
        height, where the button ends around y=460. Detail lives on /privacy-policy. */}
    <p id="consent-body" class="consent__body">
      Optional analytics cookies show us how the site is <em>used</em> — never who you
      are. Nothing is set unless you accept. <a href="/privacy-policy#cookies">What we set</a>.
    </p>
    <div class="consent__actions">
      <button type="button" class="btn btn--primary" data-consent="accept">Accept</button>
      <button type="button" class="btn" data-consent="reject">Reject</button>
    </div>
  </div>
</div>

<script is:inline set:html={script} />

<style>
  /* Fixed, not sticky: the hero has to stay inside the first fold on a phone,
     and a banner in flow would push it up. This floats over it instead. */
  .consent {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 60;
    padding: 0.75rem;
    /* Clears the home indicator on iOS rather than sitting under it. */
    padding-bottom: max(0.75rem, env(safe-area-inset-bottom));
  }
  .consent[hidden] {
    display: none;
  }

  /* Height is the constraint, not width: this floats over a hero whose CTA sits
     near the bottom of a 667px screen. Padding and gaps are deliberately tight
     — see the copy note in the markup before loosening them. */
  .consent__card {
    max-width: 60rem;
    margin-inline: auto;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg, var(--shadow-sm));
    padding: 0.75rem 0.875rem;
    display: grid;
    gap: 0.5rem;
  }

  .consent__title {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-4);
  }

  .consent__body {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .consent__body a {
    color: var(--brand-strong);
  }

  /* nowrap: wrapping would stack the buttons and add ~50px of banner height,
     which is exactly what pushes it over the hero CTA. */
  .consent__actions {
    display: flex;
    flex-wrap: nowrap;
    gap: 0.5rem;
  }
  /* ≥44px touch targets on touch widths. */
  .consent__actions .btn {
    flex: 1 1 0;
    min-height: 44px;
    justify-content: center;
    white-space: nowrap;
  }

  @media (min-width: 40rem) {
    .consent {
      padding: 1rem;
    }
    .consent__card {
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 1.25rem;
      padding: 1rem 1.25rem;
    }
    .consent__title {
      grid-column: 1;
      grid-row: 1;
    }
    .consent__body {
      grid-column: 1;
      grid-row: 2;
    }
    .consent__actions {
      grid-column: 2;
      grid-row: 1 / span 2;
      flex-wrap: nowrap;
    }
    .consent__actions .btn {
      flex: 0 0 auto;
    }
  }
</style>
