---
/**
 * Header art for a content page: a screenshot of the product screen the page is
 * about, with a caption naming it.
 *
 * The images are prepared by `marketing/screens/prepare.mjs` and live in
 * `src/assets/screens/`, so they go through Astro's image pipeline — that is
 * what emits the webp, the intrinsic width/height (no layout shift) and the
 * hashed filename. Nothing here ships a raw PNG.
 *
 * Loaded eagerly and marked `fetchpriority="high"`: this sits above the fold on
 * every content page, so lazy-loading it would only delay the LCP element.
 */
import { Image } from 'astro:assets';
import { PAGE_ART, type PageArtVariant } from '../data/pageArt';

interface Props {
  variant: PageArtVariant;
  /** Drops the caption. For slots where the surrounding copy already says it. */
  bare?: boolean;
}

const { variant, bare = false } = Astro.props;
const shot = PAGE_ART[variant];

// Resolved from a glob rather than a static import, because the variant is only
// known at render time. `eager` so this is a build-time lookup, not a runtime one.
const screens = import.meta.glob<{ default: ImageMetadata }>('../assets/screens/*.png', {
  eager: true,
});
const entry = screens[`../assets/screens/${variant}.png`];
if (!entry) {
  throw new Error(
    `PageArt: no image for variant "${variant}". Run marketing/screens/prepare.mjs against a screenshot folder.`
  );
}
---

<figure class="page-art">
  <Image
    src={entry.default}
    alt={shot.alt}
    widths={[640, 960, 1440]}
    sizes="(min-width: 48rem) 44rem, 100vw"
    loading="eager"
    fetchpriority="high"
  />
  {!bare && <figcaption>{shot.caption}</figcaption>}
</figure>

<style>
  .page-art {
    margin: 0;
  }
  .page-art img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line-2, #eaecf0);
    border-radius: 12px;
    /* The captures are of a light UI on a light page — without this the frame
       edge disappears and the screenshot reads as part of the article. */
    box-shadow: 0 1px 2px rgba(16, 24, 40, 0.04), 0 8px 24px rgba(16, 24, 40, 0.06);
  }
  .page-art figcaption {
    margin-top: 0.625rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--ink-3, #667085);
  }
</style>
