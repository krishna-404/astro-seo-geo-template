---
import { SITE, NAV } from '../data/site';

/**
 * The wordmark is plain text, deliberately. A template ships no logo asset,
 * and a styled SITE.name is legible, accessible, and needs no design work to
 * go live. Swap in an inline SVG mark here if the brand grows one.
 */
---

<header class="hdr">
  <div class="wrap hdr__in">
    <!-- No aria-label: the visible wordmark is the accessible name, so a
         voice-control user can say the brand name and hit the link. An
         aria-label that does not start with the visible text breaks that. -->
    <a href="/" class="hdr__brand">{SITE.name}</a>

    <nav class="hdr__nav" aria-label="Main">
      {
        /* The CTA below already goes to /contact, so the plain Contact link is
           skipped here — one destination, one control. Everything else renders
           as a text link and collapses on narrow widths. */
        NAV.filter((item) => item.href !== '/contact').map((item) => (
          <a href={item.href}>{item.label}</a>
        ))
      }
      {/* Contact survives the mobile collapse; the destinations do not. It is
          the only header item that is an ACTION rather than a destination, and
          on a phone the footer is a long scroll away from someone who has just
          decided they want to talk to a person. */}
      <a
        href="/contact"
        class="btn hdr__cta"
        data-umami-event="cta-contact"
        data-umami-event-place="header">Contact</a
      >
    </nav>
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid transparent;
  }

  .hdr__in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 60px;
  }

  .hdr__brand {
    flex-shrink: 0;
    /* ≥44px touch target for the home link, matching the CTA. */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 800;
    font-size: 1.125rem;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-decoration: none;
  }

  .hdr__nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /*
   * A handful of destinations plus one action — a hamburger would be more
   * chrome than content. Below the breakpoint the destinations drop; the CTA
   * survives, because a header that offers no way to reach a person sends
   * anyone who has decided to talk on a full-page scroll to the footer.
   */
  .hdr__nav a:not(.hdr__cta) {
    display: none;
    padding: 0.5rem 0.75rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ink-2);
    text-decoration: none;
    border-radius: 8px;
  }
  .hdr__nav a:not(.hdr__cta):hover {
    color: var(--ink);
    background: var(--cream);
  }

  /* Full 44px target on touch widths; tightened once there's a pointer. */
  .hdr__cta {
    min-height: 44px;
    padding: 0.4rem 0.9rem;
    font-size: 0.875rem;
  }

  /* The destinations return once there is room. Measured on the original
     layout: the text links plus the CTA fit from 46rem with no overflow at
     any width up to 1280. */
  @media (min-width: 46rem) {
    .hdr__nav a:not(.hdr__cta) {
      display: inline-block;
    }
  }

  @media (min-width: 48rem) {
    .hdr__cta {
      min-height: 38px;
    }
  }
</style>
