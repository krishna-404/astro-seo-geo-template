---
import { SITE, NAV } from '../data/site';

/**
 * The wordmark is plain text, deliberately. A template ships no logo asset,
 * and a styled SITE.name is legible, accessible, and needs no design work to
 * go live. Swap in an inline SVG mark here if the brand grows one.
 */
---

<header class="hdr">
  <div class="wrap hdr__in">
    <!-- No aria-label: the visible wordmark is the accessible name, so a
         voice-control user can say the brand name and hit the link. An
         aria-label that does not start with the visible text breaks that. -->
    <a href="/" class="hdr__brand">{SITE.name}</a>

    <nav class="hdr__nav" aria-label="Main">
      {
        /* The CTA below already goes to /contact, so the plain Contact link is
           skipped here — one destination, one control. Everything else renders
           as a text link and collapses on narrow widths. */
        NAV.filter((item) => item.href !== '/contact').map((item) => (
          <a href={item.href}>{item.label}</a>
        ))
      }
      {/* Contact survives the mobile collapse; the destinations do not. It is
          the only header item that is an ACTION rather than a destination, and
          on a phone the footer is a long scroll away from someone who has just
          decided they want to talk to a person. */}
      <a
        href="/contact"
        class="btn hdr__cta"
        data-umami-event="cta-contact"
        data-umami-event-place="header">Contact</a
      >
      {/* The phone menu: the same destinations, one tap away instead of a
          footer scroll away. Native <details>, so it needs no JavaScript,
          opens and closes with the keyboard, and animates inside the motion
          query like the FAQ. It renders only below the breakpoint; above it
          the inline links return and this is display:none. Contact is not
          repeated here — the CTA beside it is the one control for it. */}
      <details class="hdr__menu">
        <summary class="hdr__toggle">Menu</summary>
        <ul class="hdr__list">
          {NAV.filter((item) => item.href !== '/contact').map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </details>
    </nav>
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid transparent;
  }

  .hdr__in {
    display: flex;
    flex-wrap: wrap; /* at 200% text the row wraps instead of overflowing */
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    min-height: 60px;
  }

  .hdr__brand {
    min-width: 0;
    /* ≥44px touch target for the home link, matching the CTA. */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 800;
    font-size: 1.125rem;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-decoration: none;
  }

  .hdr__nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /*
   * Below the breakpoint the inline destinations drop and the .hdr__menu
   * disclosure carries them; the CTA survives outside it, because a header
   * that offers no way to reach a person sends anyone who has decided to
   * talk on a full-page scroll to the footer. (Until Sep 2026 the phone
   * header was CTA-only, on the argument that three links did not earn a
   * menu — the design playbook intake reversed it: a destination that is
   * only reachable from the footer is, on a phone, not reachable.)
   */
  .hdr__nav > a:not(.hdr__cta) {
    display: none;
    padding: 0.5rem 0.75rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ink-2);
    text-decoration: none;
    border-radius: var(--radius-sm);
  }
  .hdr__nav > a:not(.hdr__cta):hover {
    color: var(--ink);
    background: var(--cream);
  }

  /* Full 44px target on touch widths; tightened once there's a pointer. */
  .hdr__cta {
    min-height: 44px;
    padding: 0.4rem 0.9rem;
    font-size: 0.875rem;
  }

  /* The phone menu. The summary is a 44px control with the visible word as
     its accessible name (no aria-label — voice control says "Menu"); the
     list drops below the header, full width, on an opaque surface so the
     contrast sweep measures it like any band. */
  .hdr__menu {
    position: relative;
  }
  .hdr__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0.4rem 0.75rem;
    list-style: none;
    cursor: pointer;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ink-2);
    border-radius: var(--radius-sm);
  }
  .hdr__toggle::-webkit-details-marker {
    display: none;
  }
  /* A chevron drawn in CSS: no icon set, no glyph. */
  .hdr__toggle::after {
    content: '';
    width: 0.5em;
    height: 0.5em;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: translateY(-0.15em) rotate(45deg);
  }
  .hdr__menu[open] .hdr__toggle::after {
    transform: translateY(0.1em) rotate(-135deg);
  }
  .hdr__list {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    min-width: 12rem;
    margin: 0;
    padding: 0.5rem;
    list-style: none;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
  }
  .hdr__list a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ink-2);
    text-decoration: none;
    border-radius: var(--radius-sm);
  }
  .hdr__list a:hover,
  .hdr__toggle:hover {
    color: var(--ink);
    background: var(--cream);
  }
  /* Open/close as a transition, only for readers who have not asked for
     less motion (AGENTS rule 14): the same ::details-content mechanism the
     FAQ uses, so a browser without it simply toggles. */
  @media (prefers-reduced-motion: no-preference) {
    .hdr__menu::details-content {
      opacity: 0;
      translate: 0 -0.25rem;
      transition:
        opacity 150ms var(--ease-out),
        translate 150ms var(--ease-out),
        content-visibility 150ms allow-discrete;
    }
    .hdr__menu[open]::details-content {
      opacity: 1;
      translate: 0 0;
    }
  }

  /* The destinations return once there is room, and the menu goes.
     Measured on the original layout: the text links plus the CTA fit from
     46rem with no overflow at any width up to 1280. */
  @media (min-width: 46rem) {
    .hdr__nav > a:not(.hdr__cta) {
      display: inline-block;
    }
    .hdr__menu {
      display: none;
    }
  }

  @media (min-width: 48rem) {
    .hdr__cta {
      min-height: 38px;
    }
  }
</style>
