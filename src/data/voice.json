    "crutch": [
      "just", "really", "very", "actually", "basically", "simply", "quite",
      "various", "numerous", "a number of", "in order to", "the fact that"
    ],
    "shapes": {
      "$comment": "Regex tells checked against prose. `fail` shapes reject the draft; `warn` shapes are reported. Source strings, compiled case-insensitive by check-voice.mjs.",
      "fail": [
        {
          "label": "not-just-but construction as a slogan",
          "re": "\\bnot (?:just|merely) an? \\w+[,;] but\\b"
        },
        {
          "label": "vague significance ('is more than just')",
          "re": "\\bis more than just\\b"
        }
      ],
      "warn": [
        {
          "label": "negative parallelism (not only X but also Y)",
          "re": "\\bnot only\\b[^.!?\\n]{0,90}\\bbut(?: also)?\\b"
        },
        {
          "label": "present-participle significance tail (', highlighting/underscoring/reflecting …')",
          "re": ",\\s+(?:highlighting|underscoring|reflecting|showcasing|emphasizing|demonstrating|signaling|signalling)\\b"
        }
      ]
    },
    "quant": {
      "$comment": "Quantitative thresholds. A site overrides any of these in site.quantOverrides — e.g. emDashPer1000Words: 0 for a zero-em-dash house style.",
      "emDashPer1000Words": 2,
      "maxEmoji": 0,
      "maxConsecutiveBoldLeadIns": 2,
      "maxBoldProseLineRatio": 0.2,
      "allowTitleCaseHeadings": false,
      "maxHorizontalRules": 3
    }
  },
  "site": {
