---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { SITE, FOUNDER, ANALYTICS, VERIFICATION } from '../data/site';
import { ogCardFor } from '../lib/ogCard';
import { FOUNDER_PHOTO } from '../lib/founderPhoto';
import { clampTitle } from '../lib/clampTitle';

interface Props {
  title: string;
  description: string;
  /** Overrides the derived canonical. Use for legacy URLs that fold into a page. */
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** Article dates → `article:published_time` / `article:modified_time` meta.
   *  Only emitted when ogType is 'article'; scrapers ignore them elsewhere. */
  publishedTime?: Date;
  modifiedTime?: Date;
  /** Page-specific JSON-LD, appended to the site-wide Organization node. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  canonical,
  ogImage,
  ogType = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  schema,
} = Astro.props;

/**
 * `build.format: 'file'` makes Astro.url.pathname carry the emitted filename
 * (/about.html, /index.html). The served URLs are extensionless, so strip it
 * — a canonical pointing at /about.html would be a canonical to a URL the
 * server never hands out.
 */
function cleanPath(pathname: string): string {
  const stripped = pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '');
  return stripped === '' ? '/' : stripped;
}

const path = cleanPath(Astro.url.pathname);
const canonicalUrl = canonical ?? new URL(path, SITE.url).href;

/**
 * Card precedence: an explicit prop, then a generated card for this route, then
 * the site default. Collection templates pass their own card as `ogImage`, so
 * this only reaches the pages that have no slug of their own — the marketing
 * pages and the collection indexes.
 */
const ogImageUrl = new URL(ogImage ?? ogCardFor(path) ?? SITE.ogImage, SITE.url).href;

/**
 * The founder is referenced site-wide, so the Person node is site-wide rather
 * than per-page. Blog posts reference this same @id as their author instead of
 * restating the profile.
 */
const founder = {
  '@type': 'Person',
  '@id': `${SITE.url}/#founder`,
  name: FOUNDER.name,
  jobTitle: 'Founder',
  sameAs: [FOUNDER.linkedin],
  worksFor: { '@id': `${SITE.url}/#organization` },
  // Only when a photograph actually exists. An `image` pointing at nothing is
  // worse than no `image` — it is a broken claim in structured data.
  ...(FOUNDER_PHOTO ? { image: new URL(FOUNDER_PHOTO.src, SITE.url).href } : {}),
};

const organization = {
  '@type': 'Organization',
  '@id': `${SITE.url}/#organization`,
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  slogan: SITE.tagline,
  founder: { '@id': `${SITE.url}/#founder` },
};

const pageSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const graph = [organization, founder, ...pageSchemas];

/**
 * GA4 is gated behind consent and injected from <ConsentBanner />, which owns
 * the gtag snippet. Nothing to build here — see the analytics notes below.
 */
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Clamped to 60 chars for the SERP <title> only — og:title below keeps
        the full string, since social cards truncate on their own terms. */}
    <title>{clampTitle(title)}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    {/* Every card we ship is 1200x630. Declaring it lets a scraper lay out the
        preview before it has fetched the image. */}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={SITE.locale} />
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {ogType === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime.toISOString()} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {/* Bing Webmaster Tools ownership. Site-wide rather than homepage-only:
        Bing checks the root, but a token that exists on exactly one page is
        one refactor away from being lost silently. */}
    {VERIFICATION.bing && <meta name="msvalidate.01" content={VERIFICATION.bing} />}

    <meta name="theme-color" content={SITE.themeColor} />
    {/*
      FOUR ICONS, AND THE ORDER IS NOT ARBITRARY.

      A site that ships only the SVG gets the grey globe next to its domain in
      Google search rather than the mark. Google's favicon crawler wants a
      raster it can scale — its guidance names a square that is a multiple of
      48px — and it probes /favicon.ico at the root whatever the HTML says.
      Answer that with a 404 and you keep the globe.

      .ico first, because a browser takes the first icon it understands and the
      crawler wants this one. The SVG follows for browsers that prefer it: it is
      sharp at any size and a tenth of the bytes. Generated together by
      marketing/favicon.mjs from the one SVG, so the mark cannot drift between
      formats — re-run it if the logo or the brand colour changes.
    */}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.name} blog`}
      href={new URL('/rss.xml', SITE.url).href}
    />
    {/* Free discovery hint — crawlers that read HTML before robots.txt find
        the sitemap one hop sooner. */}
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <JsonLd schema={graph} />

    {
      /* Umami. Production builds only, so `astro dev` doesn't file local page
         views against real traffic, and only when a website ID is configured.
         `defer` keeps it off the critical path — these pages otherwise ship no
         JavaScript at all. Cookieless, so there is nothing to ask consent for
         and it is never gated behind the banner. */
      import.meta.env.PROD && ANALYTICS.umami.websiteId && (
        <script
          defer
          src={ANALYTICS.umami.src}
          data-website-id={ANALYTICS.umami.websiteId}
          is:inline
        />
      )
    }

    {/* GA4 is NOT loaded here. It sets cookies, so its gtag snippet is injected
        by <ConsentBanner /> only after the visitor accepts. Putting the tag
        back in <head> would make the banner decoration — see ConsentBanner.astro. */}

    <slot name="head" />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {/* Last in the body: the banner is fixed-position, so its place in the
        source order costs nothing visually, and every visitor reaches the
        content and the footer links before it. Rendered only when GA4 is
        configured — with Umami alone there are no cookies and nothing to
        consent to. Production only — the tag it gates is production only, so
        a banner in `astro dev` would be asking consent for something that
        cannot load. */}
    {import.meta.env.PROD && ANALYTICS.ga4.measurementId && <ConsentBanner />}
  </body>
</html>
