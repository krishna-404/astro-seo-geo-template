---
/**
 * Where /api/contact lands after a successful post.
 *
 * A real page rather than a JavaScript state swap, which is what lets the form
 * work with JS off — and it gives analytics a conversion URL for nothing.
 * Excluded from the sitemap and marked noindex: it is a confirmation, it says
 * nothing a searcher wants, and an indexed thank-you page is a classic way to
 * get a confusing result for your own brand name.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CONTACT } from '../../data/site';

const title = 'Thanks — we have got it';
const description = 'Your enquiry reached us. We usually reply the same working day.';
---

<BaseLayout title={title} description={description} noindex>
  <section class="band band--white">
    <div class="wrap ty">
      <p class="eyebrow">Contact</p>
      <h1>Got it. Thank you.</h1>
      <p class="lede">
        Your message landed in our inbox — not a queue. You will normally hear back the
        same working day, and always within two.
      </p>

      <p class="ty__p">
        If it is urgent, email
        <a href={CONTACT.emailHref} data-umami-event="cta-email" data-umami-event-place="contact-thanks">{CONTACT.email}</a>
        directly and mention that you have just sent the form.
      </p>

      <div class="btn-row ty__btns">
        <a
          class="btn btn--primary"
          href="/"
          data-umami-event="cta-home"
          data-umami-event-place="contact-thanks">Back to the homepage</a
        >
        <a
          class="btn"
          href="/blog"
          data-umami-event="cta-blog"
          data-umami-event-place="contact-thanks">Read the blog while you wait</a
        >
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .ty {
    max-width: 44rem;
  }
  .ty__p {
    color: var(--ink-3);
  }
  .ty__btns {
    margin-top: 1.5rem;
  }
</style>
