---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';

/**
 * Homepage. The h1 comes from SITE.tagline and the lede from SITE.description,
 * so pointing the template at a new brand rewrites this page from site.ts
 * without touching markup. The composition is the template's default design
 * direction — editorial hero, bento grid, one inverted band — built from the
 * expressive layer in global.css so it can be re-skinned in tokens; the
 * /design-direction skill is where a new site decides its own.
 */

const faq = [
  {
    q: 'What is this template?',
    a: 'A static Astro marketing-site template with the SEO, AEO and GEO machinery pre-wired: canonical URLs, JSON-LD, sitemap, RSS, llms.txt, and content collections whose schemas enforce sourced, front-loaded content.',
  },
  {
    q: 'How do I rebrand it?',
    a: 'Edit src/data/site.ts (name, tagline, description, nav, contact), origin.mjs for the domain, facts.json for your numbers, and the colour tokens in global.css. Nothing brand-specific is typed into page markup.',
  },
  {
    q: 'Does it need a server or a database?',
    a: 'No. It builds to static files that host anywhere for free. The contact form posts to a Google Apps Script and lands in a Sheet; analytics is cookieless Umami by default, so there is no consent banner unless you enable a cookie-setting vendor.',
  },
];

const schema = [
  {
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    url: SITE.url,
    name: SITE.name,
    description: SITE.description,
    publisher: { '@id': `${SITE.url}/#organization` },
    // Honest by construction: /search really does answer ?q= (Pagefind syncs
    // the param — see search.astro). This is what makes a sitelinks search
    // box eligible; never emit it for a site without a working /search.
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: `${SITE.url}/search?q={search_term_string}`,
      },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title={`${SITE.name} — ${SITE.tagline}`}
  description={SITE.description}
  schema={schema}
  ogImage={SITE.ogImage}
>
  <!--
    ogImage is explicit: the homepage shares as the BRAND card
    (marketing/og/default.html → public/og/default.png), never as a per-page
    title card. BaseLayout's precedence is "a card on disk for the route wins",
    so a page that must use the brand card has to say so. check-invariants
    fails a build whose homepage points anywhere else.
  -->
  <!--
    Hero: the editorial pattern from the expressive layer (global.css). One
    oversized h1 from SITE.tagline, a narrow lede, two measured CTAs — and a
    panel beside it that shows the site's own doctrine as a numbered rail, so
    the page has a second visual weight without a stock illustration. The
    design pass (/design-direction) swaps the panel for whatever this brand's
    proof is: a product screen, a figure from facts.json, a photograph.
  -->
  <section class="band band--white hero hero--editorial">
    <div class="wrap hero__grid">
      <div>
        <p class="eyebrow">{SITE.name}</p>
        <h1>{SITE.tagline}</h1>
        <p class="lede">{SITE.description}</p>
        <div class="btn-row">
          <a
            class="btn btn--primary"
            href="/contact"
            data-umami-event="cta-contact"
            data-umami-event-place="home-hero">Get in touch</a
          >
          <a
            class="btn"
            href="/about"
            data-umami-event="cta-about"
            data-umami-event-place="home-hero">How the template works</a
          >
        </div>
      </div>
      <aside class="card hero__panel" aria-labelledby="contract-heading">
        <p class="eyebrow">The page contract</p>
        <h2 id="contract-heading" class="hero__panel-title">Every page obeys the same five links</h2>
        <ol class="rail">
          <li><strong>One primary query</strong> — a page with no query is invisible.</li>
          <li><strong>One search intent</strong> — a sales page on a definition query ranks for nothing.</li>
          <li><strong>The page type that matches</strong> — glossary, money page, comparison, tool.</li>
          <li><strong>Wired into a cluster</strong> — a page nothing links to is stranded.</li>
          <li><strong>Carrying the answer-engine levers</strong> — the answer first, cited, quotable.</li>
        </ol>
      </aside>
    </div>
  </section>

  <!-- Bento: one lead card spanning four of six columns, then four supporters
       — 4+2 over 2+2+2 on desktop. The asymmetry is the design. -->
  <section class="band band--cream">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">What this template gives you</p>
        <h2>The machinery, pre-wired</h2>
        <p class="lede">
          Swap the brand in <code>site.ts</code>, write content, ship. Everything below is
          already built and tested.
        </p>
      </div>
      <div class="bento">
        <div class="card card--feature card--ink bento__wide reveal">
          <p class="eyebrow">SEO machinery</p>
          <h3>One layout emits every signal</h3>
          <p>
            Canonical URLs, Open Graph tags, JSON-LD (Organization, Person, BlogPosting,
            DefinedTerm, FAQPage, ItemList, BreadcrumbList), sitemap and RSS — from one
            layout and the collection templates, so no page can forget one.
          </p>
        </div>
        <div class="card card--feature reveal">
          <p class="eyebrow">Checked, not asked</p>
          <h3>Three rungs</h3>
          <p>Pre-commit, pre-push, CI — the same scripts at each, so they cannot disagree.</p>
        </div>
        <div class="card card--feature reveal">
          <p class="eyebrow">AEO &amp; GEO</p>
          <h3>The answer, first</h3>
          <p>
            Every entry front-loads a required <code>tldr</code>; glossary terms will not
            build without sources; <a href="/llms.txt">llms.txt</a>,{' '}
            <a href="/llms-full.txt">llms-full.txt</a> and <a href="/for-llms">/for-llms</a>{' '}
            are generated from the same content.
          </p>
        </div>
        <div class="card card--feature card--brand reveal">
          <p class="eyebrow">Measured</p>
          <h3>Colour clears AA on every band</h3>
          <p>A sweep of every text node on every built page fails the build under 4.5:1.</p>
        </div>
        <div class="card card--feature reveal">
          <p class="eyebrow">Zero-cost hosting</p>
          <h3>Static files, no server</h3>
          <p>
            The form lands in a Sheet you own; analytics is cookieless by default, so
            there is no consent banner until you add a vendor that needs one.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ as <details> — no JS, and the same items feed the FAQPage node above. -->
  <section class="band band--tint">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Questions</p>
        <h2>About this template</h2>
      </div>
      <div class="faq">
        {
          faq.map((f) => (
            <details class="card">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Final CTA on the inverted band: the one dark moment on the page. -->
  <section class="band band--ink">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Next</p>
        <h2>Make it yours</h2>
        <p class="lede">
          Read how the pieces fit, then replace this copy with your own pitch — and run the
          design pass before anyone sees it.
        </p>
      </div>
      <div class="btn-row">
        <a
          class="btn btn--primary"
          href="/contact"
          data-umami-event="cta-contact"
          data-umami-event-place="home-final">Get in touch</a
        >
        <a
          class="btn"
          href="/blog"
          data-umami-event="cta-blog"
          data-umami-event-place="home-final">Read the demo posts</a
        >
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero__panel {
    padding: 1.5rem;
  }
  .hero__panel-title {
    font-size: var(--step-2);
    margin-bottom: 1rem;
  }
  .hero__panel .rail li {
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .hero__panel .rail strong {
    color: var(--ink);
  }
  .faq {
    display: grid;
    gap: 0.75rem;
    max-width: 46rem;
    margin: 0 auto;
  }
  .faq summary {
    font-weight: 700;
    color: var(--ink);
    cursor: pointer;
  }
  .faq details p {
    margin: 0.75rem 0 0;
  }
</style>
