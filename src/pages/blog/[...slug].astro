---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import Toc from '../../components/Toc.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import { SITE } from '../../data/site';
import { isPublished } from '../../data/publishing.mjs';
import { faqPageNode } from '../../lib/faqSchema';
import { relatedFor, type RelatedCandidate } from '../../lib/related';

/**
 * Blog post template.
 *
 * BaseLayout already emits a site-wide Person node at `#founder` — pages that
 * the founder authors should reference that `@id` rather than restating the
 * profile. The BlogPosting node here deliberately restates its own author
 * instead: a post carries its author in frontmatter precisely so a guest post
 * attributes to the guest, and the schema must match the byline the page shows.
 *
 * Related links and the prev/next pager are computed HERE, once over the
 * sorted list, not per-page in the body — and candidates span both
 * collections, because a post about llms.txt should link the glossary entry
 * for it. The pager is blog-only: posts have a chronology; glossary entries
 * are reference material where alphabetical prev/next is navigation theatre.
 */
export async function getStaticPaths() {
  const [entries, glossary] = await Promise.all([
    getCollection('blog', ({ data }) => isPublished(data)),
    getCollection('glossary', ({ data }) => isPublished(data)),
  ]);

  const candidateOf = (e: (typeof entries)[number]): RelatedCandidate => ({
    id: e.id,
    collection: 'blog',
    title: e.data.title,
    summary: e.data.description,
    topics: e.data.tags,
    published: e.data.published,
  });
  const candidates: RelatedCandidate[] = [
    ...entries.map(candidateOf),
    ...glossary.map((e) => ({
      id: e.id,
      collection: 'glossary',
      title: e.data.term,
      summary: e.data.shortDefinition,
      topics: [e.data.category, ...e.data.aliases],
    })),
  ];

  const chrono = [...entries].sort(
    (a, b) => a.data.published.valueOf() - b.data.published.valueOf()
  );

  return entries.map((entry) => {
    const i = chrono.findIndex((e) => e.id === entry.id);
    const asLink = (e: (typeof entries)[number] | undefined) =>
      e ? { href: `/blog/${e.id}`, title: e.data.title } : null;
    return {
      params: { slug: entry.id },
      props: {
        entry,
        related: relatedFor(candidateOf(entry), candidates),
        prev: asLink(chrono[i - 1]),
        next: asLink(chrono[i + 1]),
      },
    };
  });
}

const { entry, related, prev, next } = Astro.props;
const { data } = entry;
const { Content, headings } = await render(entry);

const url = new URL(`/blog/${entry.id}`, SITE.url).href;

const published = data.published.toISOString();
const modified = (data.updated ?? data.published).toISOString();
/** Only a LATER `updated` is a real revision — sample content ships with
 *  updated == published, which used to render a redundant "updated" byline. */
const wasUpdated = data.updated != null && data.updated.valueOf() > data.published.valueOf();

const schema = [
  {
    '@type': 'BlogPosting',
    '@id': `${url}#post`,
    headline: data.title,
    description: data.description,
    mainEntityOfPage: url,
    datePublished: published,
    dateModified: modified,
    author: {
      '@type': 'Person',
      name: data.author.name,
      jobTitle: data.author.title,
      sameAs: data.author.sameAs,
    },
    publisher: { '@id': `${SITE.url}/#organization` },
    ...(data.tags.length > 0 ? { keywords: data.tags.join(', ') } : {}),
    ...(data.sources.length > 0
      ? {
          citation: data.sources.map((s) => ({
            '@type': 'CreativeWork',
            name: s.label,
            ...(s.url ? { url: s.url } : {}),
          })),
        }
      : {}),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Blog',
        item: new URL('/blog', SITE.url).href,
      },
      { '@type': 'ListItem', position: 2, name: data.title, item: url },
    ],
  },
  ...(data.faq.length > 0 ? [faqPageNode(url, data.faq)] : []),
];
---

<BaseLayout
  title={data.title}
  description={data.description}
  ogType="article"
  canonical={data.canonical}
  ogImage={data.ogImage}
  publishedTime={data.published}
  modifiedTime={wasUpdated ? data.updated : undefined}
  schema={schema}
>
  <article class="post" data-pagefind-body>
    <Breadcrumbs items={[{ label: 'Blog', href: '/blog' }, { label: data.title }]} />

    <h1>{data.title}</h1>

    <p class="post__byline">
      By <strong>{data.author.name}</strong>, {data.author.title} ·
      <time datetime={published}>{published.slice(0, 10)}</time>
      {wasUpdated && <span> · updated {modified.slice(0, 10)}</span>}
    </p>

    {/* Front-loaded answer — the lift target, first thing after the h1. */}
    <p class="post__tldr">{data.tldr}</p>

    {data.toc && <Toc headings={headings} />}

    <div class="post__body prose">
      <Content />
    </div>

    {
      data.tags.length > 0 && (
        <p class="post__tags">
          {data.tags.map((t) => (
            <span class="post__tag">{t}</span>
          ))}
        </p>
      )
    }

    {data.faq.length > 0 && <Faq faq={data.faq} groupName={entry.id} />}

    {
      data.sources.length > 0 && (
        <section class="post__sources">
          <h2>Sources</h2>
          <ol>
            {data.sources.map((s) => (
              <li>
                {s.url ? (
                  <a href={s.url} rel="nofollow noopener">
                    {s.label}
                  </a>
                ) : (
                  s.label
                )}
                {s.retrieved && (
                  <span class="post__retrieved">
                    {' '}
                    · checked {s.retrieved.toISOString().slice(0, 10)}
                  </span>
                )}
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <RelatedLinks items={related} />

    {
      (prev || next) && (
        <nav class="pager" aria-label="More posts" data-pagefind-ignore>
          {prev && (
            <a class="pager__prev" href={prev.href} rel="prev">
              <span class="pager__dir">← Older</span>
              {prev.title}
            </a>
          )}
          {next && (
            <a class="pager__next" href={next.href} rel="next">
              <span class="pager__dir">Newer →</span>
              {next.title}
            </a>
          )}
        </nav>
      )
    }

    <aside class="post__cta" data-pagefind-ignore>
      <p>
        Want to talk about what you read here — or about anything else? The contact form
        goes straight to a person.
      </p>
      <div class="btn-row">
        <a
          class="btn btn--primary"
          href="/contact"
          data-umami-event="cta-contact"
          data-umami-event-place="blog-post">Get in touch</a
        >
        <a
          class="btn"
          href="/about"
          data-umami-event="cta-about"
          data-umami-event-place="blog-post">About this site</a
        >
      </div>
    </aside>
  </article>
</BaseLayout>

<style>
  .post {
    max-width: 44rem;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
  }
  .post h1 {
    font-size: 1.875rem;
    line-height: 1.15;
    margin: 0 0 0.75rem;
  }
  .post__byline {
    font-size: 0.9375rem;
    color: var(--ink-3);
    margin: 0 0 1.5rem;
    line-height: 1.6;
  }
  /* Front-loaded answer, same treatment as the glossary. */
  .post__tldr {
    font-size: 1.125rem;
    line-height: 1.6;
    border-left: 3px solid var(--ink);
    padding-left: 1rem;
    margin: 0 0 2rem;
  }
  .post__tags {
    margin: 2rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .post__tag {
    font-size: 0.8125rem;
    background: var(--blue-tint);
    border-radius: 999px;
    padding: 0.25rem 0.625rem;
    color: var(--ink-3);
  }
  .post__sources {
    margin-top: 2.5rem;
    font-size: 0.9375rem;
  }
  .post__sources ol {
    padding-left: 1.1rem;
  }
  .post__sources li {
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }
  .post__retrieved {
    color: var(--ink-3);
  }
  .pager {
    display: grid;
    gap: 0.75rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-2);
  }
  .pager a {
    display: block;
    font-weight: 700;
    line-height: 1.4;
    min-height: 44px;
  }
  .pager__dir {
    display: block;
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--ink-3);
    margin-bottom: 0.125rem;
  }
  .pager__next {
    text-align: right;
  }

  .post__cta {
    margin-top: 3rem;
    padding: 1.5rem;
    background: var(--blue-tint);
    border-radius: var(--radius);
  }
  .post__cta p {
    margin: 0 0 1rem;
    line-height: 1.6;
  }

  @media (min-width: 48rem) {
    .post {
      padding: 3rem 1.5rem 5rem;
    }
    .post h1 {
      font-size: 2.25rem;
    }
  }
</style>
