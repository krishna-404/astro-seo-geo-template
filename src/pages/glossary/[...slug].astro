---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import Toc from '../../components/Toc.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import { SITE } from '../../data/site';
import { isPublished } from '../../data/publishing.mjs';
import { faqPageNode } from '../../lib/faqSchema';
import { relatedFor, type RelatedCandidate } from '../../lib/related';

/**
 * Canonical explainer, one URL per term.
 *
 * GEO note: the levers with evidence behind them are cited sources, quotations
 * from authorities, and statistics. Every entry carries the first two by
 * construction — `sources` is required by the schema, the TL;DR is
 * front-loaded so the answer sits in the first 30% of the page, and the
 * DefinedTerm + Article nodes make the definition machine-liftable.
 *
 * Related links: the curated `related` frontmatter ids rank first, in their
 * curated order (a missing id drops out rather than rendering a dead link);
 * the build-time scorer (src/lib/related.ts) fills the remaining slots from
 * BOTH collections — curation beats correlation, the algorithm fills gaps.
 */
export async function getStaticPaths() {
  const [entries, blog] = await Promise.all([
    getCollection('glossary', ({ data }) => isPublished(data)),
    getCollection('blog', ({ data }) => isPublished(data)),
  ]);

  const candidateOf = (e: (typeof entries)[number]): RelatedCandidate => ({
    id: e.id,
    collection: 'glossary',
    title: e.data.term,
    summary: e.data.shortDefinition,
    topics: [e.data.category, ...e.data.aliases],
  });
  const candidates: RelatedCandidate[] = [
    ...entries.map(candidateOf),
    ...blog.map((e) => ({
      id: e.id,
      collection: 'blog',
      title: e.data.title,
      summary: e.data.description,
      topics: e.data.tags,
      published: e.data.published,
    })),
  ];

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: {
      entry,
      related: relatedFor(candidateOf(entry), candidates, { seeds: entry.data.related }),
    },
  }));
}

const { entry, related } = Astro.props;
const { data } = entry;
const { Content, headings } = await render(entry);

const url = new URL(`/glossary/${entry.id}`, SITE.url).href;

const schema = [
  {
    '@type': 'DefinedTerm',
    '@id': `${url}#term`,
    name: data.term,
    description: data.shortDefinition,
    inDefinedTermSet: {
      '@type': 'DefinedTermSet',
      name: `${SITE.name} glossary`,
      url: new URL('/glossary', SITE.url).href,
    },
    ...(data.aliases.length > 0 ? { alternateName: data.aliases } : {}),
  },
  {
    '@type': 'Article',
    '@id': `${url}#article`,
    headline: data.title,
    description: data.description,
    mainEntityOfPage: url,
    /**
     * References the site-wide Person node BaseLayout emits at `#founder`
     * rather than restating the profile — one author identity, one @id, every
     * page pointing at it. (Blog posts are the exception: they restate their
     * own author so a guest post attributes to the guest.)
     */
    author: { '@id': `${SITE.url}/#founder` },
    ...(data.updated ? { dateModified: data.updated.toISOString() } : {}),
    ...(data.sources.length > 0
      ? {
          citation: data.sources.map((s) => ({
            '@type': 'CreativeWork',
            name: s.label,
            ...(s.url ? { url: s.url } : {}),
          })),
        }
      : {}),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Glossary',
        item: new URL('/glossary', SITE.url).href,
      },
      { '@type': 'ListItem', position: 2, name: data.term, item: url },
    ],
  },
  ...(data.faq.length > 0 ? [faqPageNode(url, data.faq)] : []),
];
---

<BaseLayout
  title={data.title}
  description={data.description}
  ogType="article"
  ogImage={data.ogImage}
  modifiedTime={data.updated}
  schema={schema}
>
  <article class="term" data-pagefind-body>
    <Breadcrumbs items={[{ label: 'Glossary', href: '/glossary' }, { label: data.term }]} />

    <h1>{data.title}</h1>

    {
      data.updated && (
        <p class="term__meta">
          Updated{' '}
          <time datetime={data.updated.toISOString()}>
            {data.updated.toISOString().slice(0, 10)}
          </time>
        </p>
      )
    }

    {/* The lift target. Front-loaded answer, visually distinct, first thing after h1. */}
    <p class="term__tldr">{data.tldr}</p>

    <dl class="term__def">
      <dt>{data.term}</dt>
      <dd>{data.shortDefinition}</dd>
    </dl>

    {data.toc && <Toc headings={headings} />}

    <div class="term__body prose">
      <Content />
    </div>

    <RelatedLinks items={related} />

    {data.faq.length > 0 && <Faq faq={data.faq} groupName={entry.id} place={`glossary:${entry.id}`} />}

    <section class="term__sources">
      <h2>Sources</h2>
      <ol>
        {
          data.sources.map((s) => (
            <li>
              {s.url ? (
                <a href={s.url} rel="nofollow noopener">
                  {s.label}
                </a>
              ) : (
                s.label
              )}
              {s.retrieved && (
                <span class="term__retrieved">
                  {' '}
                  · checked {s.retrieved.toISOString().slice(0, 10)}
                </span>
              )}
            </li>
          ))
        }
      </ol>
    </section>

    <aside class="term__cta" data-pagefind-ignore>
      <p>
        This entry is part of a sourced glossary — every definition cites where it came
        from. Spotted an error, or want a term added?
      </p>
      <div class="btn-row">
        <a
          class="btn btn--primary"
          href="/contact"
          data-umami-event="cta-contact"
          data-umami-event-place="glossary-term">Tell us</a
        >
        <a
          class="btn"
          href="/glossary"
          data-umami-event="cta-glossary"
          data-umami-event-place="glossary-term">All terms</a
        >
      </div>
    </aside>
  </article>
</BaseLayout>

<style>
  .term {
    max-width: 44rem;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
  }
  .term h1 {
    font-size: 1.875rem;
    line-height: 1.15;
    margin: 0 0 1rem;
  }
  .term__meta {
    font-size: 0.875rem;
    color: var(--ink-3);
    margin: -0.5rem 0 1rem;
  }
  /* The lift target. Front-loaded answer, visually distinct, first thing after h1. */
  .term__tldr {
    font-size: 1.125rem;
    line-height: 1.6;
    border-left: 3px solid var(--ink);
    padding-left: 1rem;
    margin: 0 0 2rem;
  }
  .term__def {
    background: var(--blue-tint);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    margin: 0 0 2rem;
  }
  .term__def dt {
    font-weight: 700;
    margin-bottom: 0.25rem;
  }
  .term__def dd {
    margin: 0;
  }
  .term__sources {
    margin-top: 2.5rem;
    font-size: 0.9375rem;
  }
  .term__sources ol {
    padding-left: 1.1rem;
  }
  .term__sources li {
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }
  .term__retrieved {
    color: var(--ink-3);
  }
  .term__cta {
    margin-top: 3rem;
    padding: 1.5rem;
    background: var(--blue-tint);
    border-radius: var(--radius);
  }
  .term__cta p {
    margin: 0 0 1rem;
    line-height: 1.6;
  }

  @media (min-width: 48rem) {
    .term {
      padding: 3rem 1.5rem 5rem;
    }
    .term h1 {
      font-size: 2.25rem;
    }
  }
</style>
