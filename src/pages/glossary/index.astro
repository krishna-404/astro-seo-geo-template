---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site';
import { isPublished } from '../../data/publishing.mjs';
import { GLOSSARY_CATEGORIES } from '../../data/taxonomy';

const entries = (await getCollection('glossary', ({ data }) => isPublished(data))).sort((a, b) =>
  a.data.term.localeCompare(b.data.term)
);

/**
 * Grouped by the closed category vocabulary in src/data/taxonomy.ts, in its
 * DECLARED order — the order a reader would learn the domain in, not the
 * alphabet's. Empty groups (a declared category with no entries yet) are
 * skipped rather than rendered as headings over nothing.
 */
const groups = GLOSSARY_CATEGORIES.map((c) => ({
  key: c.key,
  label: c.label,
  items: entries.filter((e) => e.data.category === c.key),
})).filter((g) => g.items.length > 0);

const schema = [
  {
    '@type': 'DefinedTermSet',
    '@id': `${SITE.url}/glossary#set`,
    name: `${SITE.name} glossary`,
    description:
      'Sourced, plain-English definitions — each entry carries a quotable short answer and at least one citation.',
    url: new URL('/glossary', SITE.url).href,
    hasDefinedTerm: entries.map((e) => ({
      '@type': 'DefinedTerm',
      name: e.data.term,
      description: e.data.shortDefinition,
      url: new URL(`/glossary/${e.id}`, SITE.url).href,
    })),
  },
];
---

<BaseLayout
  title={`Glossary — ${SITE.name}`}
  description="Sourced, plain-English definitions of the terms this site's audience needs — every entry cites its sources and front-loads a quotable answer."
  schema={schema}
>
  <div class="gloss">
    <h1>Glossary</h1>
    <p class="gloss__lede">
      Definitions written to be quoted: a short answer up top, sources at the bottom,
      and nothing in between that a reader has to wade through. The schema requires at
      least one source per entry — no source, no page.
    </p>

    {
      groups.map((g) => (
        <section class="gloss__group">
          <h2>{g.label}</h2>
          <ul>
            {g.items.map((e) => (
              <li>
                <a href={`/glossary/${e.id}`}>{e.data.term}</a>
                <span> — {e.data.shortDefinition}</span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .gloss {
    max-width: 46rem;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
  }
  .gloss h1 {
    font-size: 1.875rem;
    margin: 0 0 1rem;
  }
  .gloss__lede {
    font-size: 1.125rem;
    line-height: 1.6;
    margin: 0 0 2.5rem;
  }
  .gloss__group {
    margin-bottom: 2.5rem;
  }
  .gloss__group h2 {
    font-size: 1.125rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-3);
    margin: 0 0 0.75rem;
  }
  .gloss__group ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .gloss__group li {
    padding: 0.75rem 0;
    border-top: 1px solid var(--line-2);
    line-height: 1.6;
  }
  .gloss__group a {
    font-weight: 700;
  }

  @media (min-width: 48rem) {
    .gloss {
      padding: 3rem 1.5rem 5rem;
    }
    .gloss h1 {
      font-size: 2.25rem;
    }
  }
</style>
