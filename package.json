{
  "name": "astro-website-template",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && npm run check:worker && npm run sheets && npm run llms && astro build && npm run markdown-twins && npm run search:index && npm run csp",
    "build:ci": "npm run sheets && npm run llms && astro build && npm run markdown-twins && npm run search:index && npm run csp",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "astro check && npm run check:worker && npm run lint",
    "check:worker": "tsc --noEmit -p worker",
    "lint": "eslint .",
    "astro": "astro",
    "sheets": "node scripts/fetch-sheets.mjs",
    "llms": "node scripts/generate-llms.mjs",
    "markdown-twins": "node scripts/markdown-twins.mjs",
    "search:index": "pagefind --site dist",
    "csp": "node scripts/generate-csp.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:parity": "node scripts/check-parity.mjs && node scripts/check-source-rules.mjs",
    "check:invariants": "node scripts/check-invariants.mjs",
    "smoke:worker": "node scripts/smoke-worker.mjs",
    "verify": "node scripts/verify.mjs",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "lastmod": "node scripts/lastmod.mjs",
    "lastmod:check": "node scripts/check-lastmod.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "insights": "node scripts/insights.mjs",
    "check:voice": "node scripts/check-voice.mjs",
    "check:links": "node scripts/check-link-graph.mjs",
    "inventory": "node scripts/content-inventory.mjs",
    "purge": "node scripts/purge-cache.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "pagefind": "^1.5.2",
    "prettier": "^3.6.0",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.0.0",
    "yaml": "^2.9.0"
  }
}
