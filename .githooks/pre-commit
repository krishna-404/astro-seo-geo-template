#!/bin/sh
# Fast tier only — source-level checks that need no build (~seconds).
# The full battery (build + worker smoke + browser sweeps) runs at push time
# via .githooks/pre-push → npm run verify, and again in CI.
#
# Installed automatically: the package.json `prepare` script points
# core.hooksPath here on every npm install. Escape hatch when you must
# commit something known-red: git commit --no-verify (CI will still say no).

set -e

echo "pre-commit: fast source checks (full battery runs at push via npm run verify)"

node scripts/check-parity.mjs
node scripts/check-source-rules.mjs

node scripts/check-collection-routes.mjs

node scripts/check-content-images.mjs

npx eslint .

npm run check:worker --silent

echo "pre-commit: ok"
