# Every environment variable a script, a skill or the worker reads. Copy to
# .env (git-ignored) for local runs, or set them in the cadence Routine's
# environment. `npm run actions` says which of these are missing where it runs
# (marketing/ACTIONS.md § Keys). Nothing here is ever committed.

# ── Read-only insights (scripts/insights.mjs) — each section soft-skips when unset
GSC_SA_KEY=                 # base64 of a Google service-account JSON key; SA email added as a Restricted user on sc-domain:<site>
CLOUDFLARE_READ_ANALYTICS=  # API token scoped Zone:Read + Analytics:Read on this zone only
UMAMI_URL=                  # https://umami.example.org
UMAMI_WEBSITE_ID=           # Settings → Websites → Website ID
UMAMI_BEARER_TOKEN=         # a login token; or the pair below and the script logs in itself
UMAMI_USERNAME=
UMAMI_PASSWORD=
BING_WEBMASTER_API_KEY=     # Bing Webmaster Tools → Settings → API access (read-only use)

# ── Deploy and edge (/ship, scripts/purge-cache.mjs, scripts/indexnow.mjs)
CLOUDFLARE_DEPLOY_TOKEN=    # Edit Workers + Cache Purge, this account only — never a Global API Key
CLOUDFLARE_ZONE_ID=         # dashboard overview; the purge step needs it
INDEXNOW_KEY=               # optional: overrides the public/<key>.txt discovery

# ── The cadence report (SETUP Phase 4 § Cadence report email)
CADENCE_REPORT_TOKEN=       # the same value as REPORT_TOKEN in marketing/apps-script/contact-form.gs

# ── Browser sweeps (scripts/check-contrast.mjs, check-a11y.mjs, marketing/og/render-pages.mjs)
CHROMIUM_PATH=              # optional: a Chromium binary when Playwright's download is unwanted
CHROMIUM_CHANNEL=           # optional: e.g. chrome

# ── Worker (never here — `npx wrangler secret put <NAME>`; listed so the set is complete)
# CONTACT_SCRIPT_ID     Google Apps Script deployment id (forms)
# POSTS_API_TOKEN       bearer callers of /api/posts present
# GITHUB_POSTS_TOKEN    fine-grained PAT, Contents + Pull requests on GITHUB_REPO
# Worker vars live in wrangler.jsonc: UMAMI_UPSTREAM, GITHUB_REPO, GITHUB_BASE
