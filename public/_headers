# Header rules for Cloudflare's static asset layer. Unlike nginx's add_header,
# rules here MERGE across matches — a more specific rule adds to /* rather than
# wiping it, so the "one location silently drops every inherited security
# header" trap class does not exist on this platform.
#
# HSTS is deliberately ABSENT: a browser honours only the FIRST
# Strict-Transport-Security header it sees (RFC 6797), so there must be exactly
# one emitter. On Cloudflare that emitter is the zone-level HSTS setting
# (dashboard → SSL/TLS → Edge Certificates). Enable it there, then verify with
# `curl -sI https://DOMAIN/ | grep -ci strict-transport` → exactly 1.
#
# Worker-generated responses (anything on wrangler.jsonc's run_worker_first
# list — /api/*, /hi, negotiated .md, and their pass-throughs) do NOT go
# through this file — the worker's withSecurityHeaders() sets the same values
# in code. The two MUST stay in lockstep: change the security set or the Link
# header here and in worker/index.ts together.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=(), interest-cohort=(), unload=()
  # @generated-csp — replaced with the real Content-Security-Policy by
  # scripts/generate-csp.mjs (runs inside `npm run build`; hashes derive from
  # the built inline scripts, so the policy is never hand-listed). If this
  # comment ships to production the generator did not run — the site still
  # works, it just serves no CSP.
  Cache-Control: public, max-age=300, must-revalidate
  Link: </llms.txt>; rel="describedby"; type="text/plain"; title="LLM brief", </for-llms>; rel="service-doc"; title="For LLMs and AI assistants", </llms-full.txt>; rel="describedby"; type="text/plain"; title="LLM corpus"

# Extension-class assets: any image dropped into public/ outside the
# fingerprinted pipeline gets the same refreshable week nginx gave the class,
# not the 5-minute page TTL. These rules sit BEFORE /_astro/* on purpose —
# rules apply in file order, so /_astro re-detaches Cache-Control afterwards
# and fingerprinted images keep their immutable year.
/*.svg
  ! Cache-Control
  Cache-Control: public, max-age=604800
/*.png
  ! Cache-Control
  Cache-Control: public, max-age=604800
/*.jpg
  ! Cache-Control
  Cache-Control: public, max-age=604800
/*.jpeg
  ! Cache-Control
  Cache-Control: public, max-age=604800
/*.webp
  ! Cache-Control
  Cache-Control: public, max-age=604800
/*.ico
  ! Cache-Control
  Cache-Control: public, max-age=604800
/*.woff2
  ! Cache-Control
  Cache-Control: public, max-age=604800

# Pagefind's index chunks are content-hashed (index/ and fragment/ filenames
# change when content does) — immutable, same rationale as /_astro/*. The
# loader files (pagefind.js, the wasm, pagefind-entry.json) live at STABLE
# URLs and inherit the 5-minute page rule from /* — pagefind-entry.json is the
# version manifest that names the hashed chunks, so it MUST stay short-TTL or
# a deploy strands visitors on a stale index.
/pagefind/index/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/pagefind/fragment/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Fingerprinted build output: the hash in the filename IS the cache key, so
# cache forever. Astro's image pipeline output lands here too.
#
# `! Cache-Control` DETACHES the value inherited from /* before setting the
# new one. Without it the two values CONCATENATE into one nonsense header
# ("max-age=300, must-revalidate, public, max-age=31536000") — merging is
# what makes _headers safe for the security set, and exactly what makes it
# wrong for a header that must be replaced. Verified with curl, not assumed.
/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Stable-URL assets: refreshable within a week. These URLs never change, so
# they must not be immutable — a regenerated favicon has to be able to land.
/og/*
  ! Cache-Control
  Cache-Control: public, max-age=604800
/favicon.ico
  ! Cache-Control
  Cache-Control: public, max-age=604800
/favicon.svg
  ! Cache-Control
  Cache-Control: public, max-age=604800
/favicon-48.png
  ! Cache-Control
  Cache-Control: public, max-age=604800
/favicon-96.png
  ! Cache-Control
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  ! Cache-Control
  Cache-Control: public, max-age=604800
